{
  "name": "ht32-vscode",
  "displayName": "Holtek HT32 VS Code Extension",
  "description": "Create, convert, and manage Holtek HT32 projects in VS Code. Supports Keil uVision (.uvprojx) and HT32-IDE (.project/.cproject) conversion, with build, flash, and debug support.",
  "version": "0.3.3",
  "publisher": "holtek",
  "icon": "icons/ht32.png",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.106.3"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "main": "./out/ht32-project-assistant-for-vs-code.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "extensionPack": [
    "marus25.cortex-debug",
    "holtek.ht32-config-vscode",
    "llvm-vs-code-extensions.vscode-clangd"
  ],
  "categories": [
    "Other",
    "Programming Languages",
    "Debuggers"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ht32-holtek/ht32-vscode"
  },
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.vscode/*/project.meta.json",
    "onView:ht32ProjectView",
    "onCommand:ht32.convertUvision",
    "onCommand:ht32.convertHt32Ide",
    "onCommand:ht32.generateTasksLaunch",
    "onCommand:ht32.regenerateCompileCommands",
    "onCommand:ht32.regenerateMakefile",
    "onCommand:ht32.createProject",
    "onCommand:ht32.openProject",
    "onCustomEditor:ht32.ht32vsEditor"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ht32.openReadme",
        "category": "HT32",
        "title": "View README",
        "icon": "$(book)"
      },
      {
        "command": "ht32.createProject",
        "category": "HT32",
        "title": "Create Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "ht32.openProject",
        "category": "HT32",
        "title": "Open Project",
        "icon": "$(folder-library)"
      },
      {
        "command": "ht32.openProjectFolder",
        "category": "HT32",
        "title": "Open Project (Folder)",
        "icon": "$(folder-opened)"
      },
      {
        "command": "ht32.renameProjectFile",
        "category": "HT32",
        "title": "Rename Project File",
        "icon": "$(edit)"
      },
      {
        "command": "ht32.addNewProject",
        "category": "HT32",
        "title": "Add New Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "ht32.addProject",
        "category": "HT32",
        "title": "Add Existing Project",
        "icon": "$(new-collection)"
      },
      {
        "command": "ht32.treeRevealProjectFolder",
        "category": "HT32",
        "title": "Open Folder in Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "ht32.deleteProject",
        "category": "HT32",
        "title": "Remove Project",
        "icon": "$(remove)"
      },
      {
        "command": "ht32.clearRecentProjects",
        "category": "HT32",
        "title": "Clear Recent Projects",
        "icon": "$(clear-all)"
      },
      {
        "command": "ht32.updateFromMarketplace",
        "category": "HT32",
        "title": "Update Extension (Online)",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ht32.updateDevicePacks",
        "category": "HT32",
        "title": "Update Device Packs (Online)",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ht32.installPackFile",
        "category": "HT32",
        "title": "Install Device Pack from File",
        "icon": "$(package)"
      },
      {
        "command": "ht32.installFromVsix",
        "category": "HT32",
        "title": "Install Extension from VSIX",
        "icon": "$(package)"
      },
      {
        "command": "ht32.convertUvision",
        "category": "HT32",
        "title": "Convert uVision Project",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "ht32.convertHt32Ide",
        "category": "HT32",
        "title": "Convert HT32-IDE Projects",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "ht32.generateTasksLaunch",
        "category": "HT32",
        "title": "Generate Build & Debug Config",
        "icon": "$(json)"
      },
      {
        "command": "ht32.regenerateCompileCommands",
        "category": "HT32",
        "title": "Regenerate compile_commands.json"
      },
      {
        "command": "ht32.regenerateMakefile",
        "category": "HT32",
        "title": "Regenerate Makefile"
      },
      {
        "command": "ht32.build",
        "category": "HT32",
        "title": "Build",
        "icon": "$(build)"
      },
      {
        "command": "ht32.stopBuild",
        "category": "HT32",
        "title": "Stop Build",
        "icon": "$(stop-circle)"
      },
      {
        "command": "ht32.download",
        "category": "HT32",
        "title": "Download",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ht32.eraseFlash",
        "category": "HT32",
        "title": "Erase Flash",
        "icon": {
          "light": "icons/erase_light.svg",
          "dark": "icons/erase_dark.svg"
        }
      },
      {
        "command": "ht32.runClean",
        "category": "HT32",
        "title": "Clean",
        "icon": "$(clear-all)"
      },
      {
        "command": "ht32.startDebug",
        "category": "HT32",
        "title": "Debug",
        "icon": "$(debug-alt)"
      },
      {
        "command": "ht32.openSettings",
        "category": "HT32",
        "title": "Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ht32.treeMoveProjectUp",
        "category": "HT32",
        "title": "Move Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "ht32.treeMoveProjectDown",
        "category": "HT32",
        "title": "Move Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "ht32.treeAddGroup",
        "category": "HT32",
        "title": "Add Group",
        "icon": "$(add)"
      },
      {
        "command": "ht32.treeAddNewFilesToGroup",
        "category": "HT32",
        "title": "Add New Files",
        "icon": "$(new-file)"
      },
      {
        "command": "ht32.treeAddExistingFilesToGroup",
        "category": "HT32",
        "title": "Add Existing Files",
        "icon": "$(file-add)"
      },
      {
        "command": "ht32.treeFileSettings",
        "category": "HT32",
        "title": "File Settings...",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ht32.treeDelete",
        "category": "HT32",
        "title": "Remove / Delete...",
        "icon": "$(trash)"
      },
      {
        "command": "ht32.closeProject",
        "category": "HT32",
        "title": "Close Project",
        "icon": "$(folder)"
      },
      {
        "command": "ht32.refreshStackAnalysis",
        "category": "HT32",
        "title": "Refresh Stack Usage",
        "icon": "$(refresh)"
      },
      {
        "command": "ht32.refreshProjectTree",
        "category": "HT32",
        "title": "Refresh Project Tree"
      }
    ],
    "configuration": {
      "title": "HT32 VS Code Extension (V0.3.3)",
      "properties": {
        "ht32.internal.activeProjectFile": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "markdownDescription": "%ht32.config.activeProjectFile%"
        },
        "ht32.internal.extensionRoot": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "%ht32.config.extensionRoot%"
        },
        "ht32.gccPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "%ht32.config.gccPath%"
        },
        "ht32.openocdPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "%ht32.config.openocdPath%"
        },
        "ht32.makePath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "%ht32.config.makePath%"
        },
        "ht32.buildBeforeDebug": {
          "type": "boolean",
          "scope": "machine",
          "default": true,
          "markdownDescription": "%ht32.config.buildBeforeDebug%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ht32Assistant",
          "title": "HT32 VS Code Extension (V0.3.3)",
          "icon": "icons/ht32.svg"
        }
      ]
    },
    "views": {
      "ht32Assistant": [
        {
          "id": "ht32ProjectView",
          "name": "%ht32.view.projects%"
        },
        {
          "id": "ht32RecentView",
          "name": "%ht32.view.recentProjects%",
          "when": "ht32.hasRecent && !ht32.hasProject"
        }
      ],
      "debug": [
        {
          "id": "ht32StackView",
          "name": "HT32 STACK USAGE",
          "when": "ht32.hasProject && inDebugMode"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "ht32.ht32vsEditor",
        "displayName": "HT32 Project",
        "selector": [{ "filenamePattern": "*.ht32vs" }],
        "priority": "default"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "ht32.addNewProject",
          "when": "view == ht32ProjectView && viewItem == vscodeRoot",
          "group": "inline@1"
        },
        {
          "command": "ht32.addProject",
          "when": "view == ht32ProjectView && viewItem == vscodeRoot",
          "group": "inline@2"
        },
        {
          "command": "ht32.renameProjectFile",
          "when": "view == ht32ProjectView && viewItem == vscodeRoot",
          "group": "1_edit@1"
        },
        {
          "command": "ht32.treeMoveProjectUp",
          "when": "view == ht32ProjectView && (viewItem == project-last || viewItem == project-mid)",
          "group": "1_order@1"
        },
        {
          "command": "ht32.treeMoveProjectDown",
          "when": "view == ht32ProjectView && (viewItem == project-first || viewItem == project-mid)",
          "group": "1_order@2"
        },
        {
          "command": "ht32.treeRevealProjectFolder",
          "when": "view == ht32ProjectView && viewItem =~ /^project/",
          "group": "2_edit@0"
        },
        {
          "command": "ht32.deleteProject",
          "when": "view == ht32ProjectView && viewItem =~ /^project/",
          "group": "2_edit@1"
        },
        {
          "command": "ht32.treeAddGroup",
          "when": "view == ht32ProjectView && viewItem =~ /^project/",
          "group": "2_edit@2"
        },
        {
          "command": "ht32.treeAddNewFilesToGroup",
          "when": "view == ht32ProjectView && (viewItem == group || viewItem == groupMixed || viewItem == groupFolder)",
          "group": "1_edit@1"
        },
        {
          "command": "ht32.treeAddExistingFilesToGroup",
          "when": "view == ht32ProjectView && (viewItem == group || viewItem == groupMixed || viewItem == groupFolder)",
          "group": "1_edit@2"
        },
        {
          "command": "ht32.treeAddGroup",
          "when": "view == ht32ProjectView && (viewItem == group || viewItem == groupMixed || viewItem == groupFolder)",
          "group": "1_edit@3"
        },
        {
          "command": "ht32.treeDelete",
          "when": "view == ht32ProjectView && (viewItem == group || viewItem == groupMixed || viewItem == groupFolder)",
          "group": "1_edit@4"
        },
        {
          "command": "ht32.treeFileSettings",
          "when": "view == ht32ProjectView && (viewItem == file || viewItem == sourceFile)",
          "group": "1_edit@0"
        },
        {
          "command": "ht32.treeDelete",
          "when": "view == ht32ProjectView && (viewItem == file || viewItem == sourceFile)",
          "group": "1_edit@1"
        },
        {
          "command": "ht32.treeDelete",
          "when": "view == ht32ProjectView && viewItem == linkerFile",
          "group": "1_edit@1"
        }
      ],
      "view/title": [
        {
          "command": "ht32.createProject",
          "when": "view == ht32ProjectView && !ht32.hasProject",
          "group": "navigation@1"
        },
        {
          "command": "ht32.openProject",
          "when": "view == ht32ProjectView && !ht32.hasProject",
          "group": "navigation@2"
        },
        {
          "command": "ht32.convertUvision",
          "when": "view == ht32ProjectView && !ht32.hasProject",
          "group": "1_convert@1"
        },
        {
          "command": "ht32.convertHt32Ide",
          "when": "view == ht32ProjectView && !ht32.hasProject",
          "group": "1_convert@2"
        },
        {
          "command": "ht32.build",
          "when": "view == ht32ProjectView && ht32.hasProject && !ht32.isBuilding",
          "group": "navigation@1"
        },
        {
          "command": "ht32.stopBuild",
          "when": "view == ht32ProjectView && ht32.hasProject && ht32.isBuilding",
          "group": "navigation@1"
        },
        {
          "command": "ht32.startDebug",
          "when": "view == ht32ProjectView && ht32.hasProject",
          "group": "navigation@2"
        },
        {
          "command": "ht32.runClean",
          "when": "view == ht32ProjectView && ht32.hasProject",
          "group": "navigation@3"
        },
        {
          "command": "ht32.download",
          "when": "view == ht32ProjectView && ht32.hasProject",
          "group": "navigation@4"
        },
        {
          "command": "ht32.eraseFlash",
          "when": "view == ht32ProjectView && ht32.hasProject",
          "group": "navigation@5"
        },
        {
          "command": "ht32.openSettings",
          "when": "view == ht32ProjectView && ht32.hasProject",
          "group": "navigation@6"
        },
        {
          "command": "ht32.generateTasksLaunch",
          "when": "view == ht32ProjectView && ht32.hasProject",
          "group": "navigation@7"
        },
        {
          "command": "ht32.createProject",
          "when": "view == ht32ProjectView && ht32.hasProject",
          "group": "1_project@1"
        },
        {
          "command": "ht32.openProject",
          "when": "view == ht32ProjectView && ht32.hasProject",
          "group": "1_project@2"
        },
        {
          "command": "ht32.closeProject",
          "when": "view == ht32ProjectView && ht32.hasProject",
          "group": "1_project@3"
        },
        {
          "command": "ht32.refreshStackAnalysis",
          "when": "view == ht32StackView",
          "group": "navigation"
        },
        {
          "command": "ht32.clearRecentProjects",
          "when": "view == ht32RecentView",
          "group": "navigation"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "ht32-build",
        "required": ["cwd"],
        "properties": {
          "make":      { "type": "string",                            "description": "Full path to make executable" },
          "cwd":       { "type": "string",                            "description": "Working directory for make" },
          "args":      { "type": "array", "items": { "type": "string" }, "description": "make arguments" },
          "extraPath": { "type": "array", "items": { "type": "string" }, "description": "Directories to prepend to PATH" }
        }
      },
      {
        "type": "ht32-download",
        "required": ["exe", "cwd"],
        "properties": {
          "exe":         { "type": "string",                            "description": "Full path to executable (openocd or pyocd)" },
          "cwd":         { "type": "string",                            "description": "Working directory (workspace root)" },
          "args":        { "type": "array", "items": { "type": "string" }, "description": "Command arguments" },
          "passthrough": { "type": "boolean",                           "description": "Pass output through unchanged (for tools with their own ANSI coloring, e.g. pyocd)" }
        }
      },
      {
        "type": "ht32-postbuild",
        "required": ["command", "cwd"],
        "properties": {
          "command":   { "type": "string",                            "description": "Post-build shell command (e.g. arm-none-eabi-objcopy ...)" },
          "cwd":       { "type": "string",                            "description": "Working directory (workspace root)" },
          "extraPath": { "type": "array", "items": { "type": "string" }, "description": "Directories to prepend to PATH" }
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.ht32vs",
        "url": "./schemas/ht32vs.schema.json"
      }
    ],
    "keybindings": [
      {
        "command": "ht32.treeDelete",
        "key": "delete",
        "when": "focusedView == ht32ProjectView"
      },
      {
        "command": "ht32.build",
        "key": "ctrl+shift+b",
        "when": "ht32.hasProject"
      },
      {
        "command": "ht32.startDebug",
        "key": "ctrl+shift+d",
        "when": "ht32.hasProject"
      },
      {
        "command": "ht32.download",
        "key": "ctrl+alt+d",
        "when": "ht32.hasProject"
      },
      {
        "command": "ht32.runClean",
        "key": "ctrl+alt+c",
        "when": "ht32.hasProject"
      }
    ],
    "viewsWelcome": [
      {
        "view": "ht32ProjectView",
        "contents": "%ht32.viewsWelcome.start%",
        "when": "!ht32.hasProject"
      },
      {
        "view": "ht32ProjectView",
        "contents": "%ht32.viewsWelcome.convert%",
        "when": "!ht32.hasProject"
      },
      {
        "view": "ht32ProjectView",
        "contents": "%ht32.viewsWelcome.updates%",
        "when": "!ht32.hasProject"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/ht32-project-assistant-for-vs-code.ts --bundle --outfile=out/ht32-project-assistant-for-vs-code.js --external:vscode --platform=node --target=node18 --minify",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "fast-xml-parser": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.106.3",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
